{
  "name": "@chubbyts/chubbyts-http-trpc",
  "type": "module",
  "version": "1.0.0",
  "description": "A tRPC adapter for @chubbyts/chubbyts-http-types.",
  "keywords": [
    "chubbyts",
    "http",
    "trpc",
    "adapter",
    "handler"
  ],
  "author": "Dominik Zogg",
  "license": "MIT",
  "repository": "chubbyts/chubbyts-http-trpc",
  "scripts": {
    "build": "rm -Rf dist && tsc",
    "cs-fix": "prettier --write src tests",
    "cs": "prettier --check src tests",
    "infection": "stryker run",
    "lint-fix": "oxlint --fix src tests vitest.config.ts",
    "lint": "oxlint src tests vitest.config.ts",
    "prepare": "pnpm run build",
    "test": "vitest"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@chubbyts/chubbyts-http-fetch": "^1.0.1",
    "@chubbyts/chubbyts-http-types": "^4.3.1"
  },
  "peerDependencies": {
    "@trpc/server": "^11.0.0"
  },
  "devDependencies": {
    "@chubbyts/chubbyts-framework": "^4.2.1",
    "@chubbyts/chubbyts-framework-router-path-to-regexp": "^4.2.0",
    "@chubbyts/chubbyts-function-mock": "^2.4.1",
    "@chubbyts/chubbyts-http": "^3.2.1",
    "@chubbyts/chubbyts-http-cors": "^3.1.1",
    "@chubbyts/chubbyts-http-node": "^1.2.1",
    "@chubbyts/chubbyts-oxlint": "^1.0.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@trpc/server": "^11.29.11",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
